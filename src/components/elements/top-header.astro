---
import { Image } from "astro:assets";
import Search01 from "@/assets/svgs/search-01.astro";
import MenuDropdown from "./menu-dropdown.astro";
import ThemeController from "../bases/theme-controller.astro";
import logo from "@/assets/images/brand/logo-white.png";
import { SITE } from "@/lib/config";
---

<!-- Dodger-blue top bar with the DodgerBytes logo -->
<div class="navbar bg-primary text-primary-content dark:bg-neutral dark:text-neutral-content min-h-0 py-2 [&_.btn]:text-white [&_.btn:hover]:bg-white/10">
  <div class="navbar-start lg:w-1/3">
    <MenuDropdown />
  </div>
  <div class="navbar-center">
    <a href="/" aria-label={`${SITE.title} home`} class="flex items-center">
      <Image src={logo} alt="DodgerBytes" height={56} class="h-12 lg:h-14 w-auto" loading="eager" />
    </a>
  </div>
  <div class="navbar-end lg:w-1/3">
    <ThemeController />
    <a class="btn btn-ghost btn-circle" href="/search" aria-label="Search">
      <Search01 />
    </a>
  </div>
</div>
<!-- Thin Dodger-red stripe, like the cards' accent line -->
<div class="h-1 bg-secondary"></div>
