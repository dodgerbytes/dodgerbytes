---
import { NAVIGATION_LINKS } from "@/lib/config";
import NavbarItem from "../bases/navbar-item.astro";
---

<nav class="navbar-center hidden lg:flex container py-1">
  <ul class="menu menu-sm menu-horizontal px-1 mx-auto font-serif uppercase tracking-wider text-[0.8rem]">
    <NavbarItem item={{ href: "/", text: "Home" }} />
    <NavbarItem item={{ href: "/articles", text: "Latest" }} />
    {NAVIGATION_LINKS.map((item) => <NavbarItem item={item} />)}
  </ul>
</nav>
